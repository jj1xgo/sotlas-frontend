{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/x/issues",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_PAT}"
      }
    },
    "playwright": {
      "command": "node",
      "env": {
        "XDG_CACHE_HOME": "/tmp/playwright-mcp/xdg-cache",
        "XDG_CONFIG_HOME": "/tmp/playwright-mcp/xdg-config",
        "XDG_DATA_HOME": "/tmp/playwright-mcp/xdg-data"
      },
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--browser", "chromium",
        "--executable-path", "/usr/bin/chromium",
        "--headless",
        "--no-sandbox",
        "--isolated",
        "--viewport-size", "1280x800",
        "--caps", "vision",
        "--output-dir", ".claude/playwright-mcp"
      ]
    },
    "codex": {
      "command": "codex",
      "args": ["mcp-server"]
    }
  }
}
